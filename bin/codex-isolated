#!/usr/bin/env bash

set -euo pipefail

# Localiza a infraestrutura, mesmo quando o launcher
# é executado através de um link simbólico.
SCRIPT_PATH="$(realpath -e -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
BASE_DIR="$(dirname "$SCRIPT_DIR")"

usage() {
  echo "Uso:"
  echo "  codex-isolated <readonly|dev> <diretorio-git> [runtime]"
  echo "  codex-isolated status <readonly|dev> <diretorio-git> [runtime]"
  echo "  codex-isolated check <readonly|dev> <diretorio-git> [runtime]"
  echo "  codex-isolated prepare <diretorio-git>"
  echo "  codex-isolated review <diretorio-git>"
  echo "  codex-isolated diff <diretorio-git>"
  echo "  codex-isolated merge <diretorio-git>"
  echo "  codex-isolated resolve <diretorio-git> <sessao>"
  echo
  echo "Runtimes: ruby (padrão), node, python, php"
  exit 1
}

# Comandos que não precisam iniciar o Docker.
case "${1:-}" in
  prepare|review|diff|merge)
    [[ $# -eq 2 ]] || usage

    ACTION="$1"
    shift

    exec python3 \
      "$BASE_DIR/bin/${ACTION}_workspace.py" \
      "$1"
    ;;

  resolve)
    [[ $# -eq 3 ]] || usage

    exec python3 \
      "$BASE_DIR/bin/resolve_workspace.py" \
      "$2" "$3"
    ;;
esac

# Comandos que utilizam Docker.
ACTION="run"

if [[ "${1:-}" == "status" || "${1:-}" == "check" ]]; then
  ACTION="$1"
  shift
fi

[[ $# -ge 2 && $# -le 3 ]] || usage

MODE="$1"
ORIGINAL_WORKSPACE="$2"
RUNTIME="${3:-ruby}"

case "$MODE" in
  readonly|dev) ;;
  *) usage ;;
esac

case "$RUNTIME" in
  ruby|node|python|php) ;;
  *)
    echo "Runtime não suportado: $RUNTIME" >&2
    usage
    ;;
esac

# Valida o repositório informado pelo desenvolvedor.
if [[ ! -d "$ORIGINAL_WORKSPACE" ]]; then
  echo "Erro: diretório não encontrado: $ORIGINAL_WORKSPACE" >&2
  exit 1
fi

ORIGINAL_WORKSPACE="$(
  realpath -e -- "$ORIGINAL_WORKSPACE"
)"

# Impede caminhos excessivamente abrangentes.
case "$ORIGINAL_WORKSPACE" in
  /|/home|"$HOME"|"$BASE_DIR")
    echo "Erro: diretório original não permitido." >&2
    exit 1
    ;;
esac

# Localiza obrigatoriamente o workspace preparado.
# O repositório original nunca é enviado como bind mount.
WORKSPACE="$(
  python3 "$BASE_DIR/bin/locate_workspace.py" \
    "$ORIGINAL_WORKSPACE"
)"

# Verifica novamente o workspace antes de permitir
# que ele seja disponibilizado ao container.
python3 "$BASE_DIR/bin/audit_workspace.py" \
  "$ORIGINAL_WORKSPACE"

# Defesa adicional contra caminhos inesperados.
case "$WORKSPACE" in
  /|/home|"$HOME"|"$BASE_DIR"|"$ORIGINAL_WORKSPACE")
    echo "Erro: workspace isolado inválido." >&2
    exit 1
    ;;
esac

# Bloqueia nomes conhecidos de arquivos sensíveis
# no diretório que será efetivamente montado.
SENSITIVE_FILE="$(
  find "$WORKSPACE" \
    \( -type f -o -type l \) \
    \( \
      -name '.env' -o \
      -name '.env.*' -o \
      -name '*.pem' -o \
      -name '*.key' -o \
      -name '*.p12' -o \
      -name '*.pfx' -o \
      -name 'master.key' -o \
      -name 'credentials.yml.enc' -o \
      -name '*.csv' -o \
      -name '*.xlsx' -o \
      -name '*.xlsm' \
    \) \
    -print -quit
)"

if [[ -n "$SENSITIVE_FILE" ]]; then
  echo "Workspace contém arquivo potencialmente sensível:" >&2
  echo "$SENSITIVE_FILE" >&2
  echo "Revise a cópia preparada antes de continuar." >&2
  exit 1
fi

# Identidade estável baseada no projeto original.
PROJECT_NAME="$(
  printf '%s' "$(basename "$ORIGINAL_WORKSPACE")" |
    tr '[:upper:]' '[:lower:]' |
    tr -c 'a-z0-9_-' '-'
)"

PROJECT_NAME="${PROJECT_NAME:0:24}"

PROJECT_HASH="$(
  printf '%s' "$ORIGINAL_WORKSPACE" |
    sha256sum |
    cut -c1-12
)"

export CODEX_STACK="codex-${PROJECT_NAME}-${PROJECT_HASH}"
export CODEX_WORKSPACE="$WORKSPACE"
export CODEX_RUNTIME="$RUNTIME"
export CODEX_MODE="$MODE"

COMPOSE_FILES=(-f compose.yaml)

if [[ "$MODE" == "dev" ]]; then
  COMPOSE_FILES+=(-f compose.dev.yaml)
fi

cd "$BASE_DIR"

echo "Modo: $MODE"
echo "Projeto original: $ORIGINAL_WORKSPACE"
echo "Workspace isolado: $CODEX_WORKSPACE"
echo "Ambiente: $CODEX_STACK"
echo "Runtime: $CODEX_RUNTIME"

# Valida a configuração efetiva do Compose.
docker compose "${COMPOSE_FILES[@]}" config --quiet

inspect_configuration() {
  docker compose "${COMPOSE_FILES[@]}" \
    config --format json |
    python3 "$BASE_DIR/bin/inspect_config.py"
}

check_runtime() {
  docker compose "${COMPOSE_FILES[@]}" \
    run --rm --no-deps -T \
    -e CODEX_CHECK_MODE="$MODE" \
    codex node - < "$BASE_DIR/bin/check_runtime.js"
}

if [[ "$ACTION" == "status" ]]; then
  inspect_configuration
  exit 0
fi

# Confirma que a imagem selecionada existe.
IMAGE="codex-isolated:$CODEX_RUNTIME"

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "Imagem não encontrada: $IMAGE" >&2
  echo "Construa a imagem antes de continuar:" >&2
  echo "  cd $BASE_DIR" >&2
  echo "  CODEX_RUNTIME=$CODEX_RUNTIME docker compose build codex" >&2
  exit 1
fi

if [[ "$ACTION" == "check" ]]; then
  inspect_configuration
  echo
  echo "Executando testes no container..."
  check_runtime
  exit 0
fi

# O Docker é a fronteira de isolamento.
# O sandbox interno do Codex não consegue criar
# namespaces dentro deste container restrito.
docker compose "${COMPOSE_FILES[@]}" run --rm \
  codex codex \
  --cd /workspace \
  --sandbox danger-full-access \
  --ask-for-approval on-request \
  --no-alt-screen
